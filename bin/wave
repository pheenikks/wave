#!/usr/bin/env python3
"""Wave: a tape-shelf game launcher.

  wave                     open or close the launcher (starts it if needed)
  wave show | hide
  wave start               start in the background, hidden
  wave quit

  wave add "Title" --exec "command"   put a game on the shelf
  wave add --steam APPID              add an installed Steam game
  wave steam                          list installed Steam games and their APPIDs
  wave proton ["Title" VERSION]       list Proton versions, or pick one for a Steam game
  wave prime "Title"       switch the dedicated GPU (PRIME) on or off for a game
  wave remove "Title"
  wave list
  wave edit                open games.json in $EDITOR

  wave theme [NAME]        list themes, or switch to one
  wave color PRIMARY [BASE]   recolour with two colours, e.g. wave color '#6203fc' '#000000'
  wave color --reset

  wave mem                 show how much memory and CPU Wave is using right now
  wave update              get the newest version and restart
  wave uninstall           remove Wave (your games and settings are kept)
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CONF = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "wave"
QS_CONFIG = os.environ.get("WAVE_CONFIG", "wave")
REPO = Path(__file__).resolve().parent.parent
GAMES = CONF / "games.json"
CONFIG = CONF / "config.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "wave"


def die(msg):
    sys.exit("wave: " + msg)


# ---- talking to the running launcher -------------------------------------

def ipc(*args):
    try:
        return subprocess.run(["qs", "-c", QS_CONFIG, "ipc", "call", "wave", *args],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    except FileNotFoundError:
        die("Quickshell ('qs') is not installed or not on your PATH")


def start():
    subprocess.Popen(["qs", "-c", QS_CONFIG], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def window(action):
    if ipc(action):
        return
    start()  # not running yet
    want = "show" if action == "toggle" else action
    for _ in range(50):
        time.sleep(0.1)
        if ipc(want):
            return
    die(f"the launcher did not come up. Run 'qs -c {QS_CONFIG}' to see why.")


# ---- files -----------------------------------------------------------------

def read(path, fallback):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return fallback
    except json.JSONDecodeError as e:
        die(f"{path} is not valid JSON ({e}). Fix it, or run 'wave edit'.")


def write(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    # written in place (not replaced) so the running launcher's file watch survives
    with open(path, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")


def slug(s):
    return re.sub(r"[^a-z0-9]+", "-", str(s).lower()).strip("-")


def keep_art(src, game_id, kind):
    """Copy an image into ~/.config/wave/covers and return the path to store."""
    src = Path(src).expanduser()
    if not src.is_file():
        die(f"no such image: {src}")
    dest = CONF / "covers" / f"{game_id}{'' if kind == 'cover' else '-' + kind}{src.suffix.lower()}"
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.resolve() != dest.resolve():
        shutil.copyfile(src, dest)
    return str(dest.relative_to(CONF))


# ---- Steam -----------------------------------------------------------------

def steam_roots():
    for p in (HOME / ".local/share/Steam", HOME / ".steam/steam", HOME / ".steam/root",
              HOME / ".var/app/com.valvesoftware.Steam/.local/share/Steam"):
        if p.is_dir():
            yield p.resolve()


def steam_lookup(appid):
    """Title and local artwork for an installed Steam game."""
    name, art = None, {}
    for root in dict.fromkeys(steam_roots()):
        libs = [root]
        vdf = root / "steamapps/libraryfolders.vdf"
        if vdf.is_file():
            libs += [Path(m) for m in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="ignore"))]
        for lib in libs:
            manifest = lib / "steamapps" / f"appmanifest_{appid}.acf"
            if manifest.is_file() and not name:
                m = re.search(r'"name"\s+"([^"]+)"', manifest.read_text(errors="ignore"))
                name = m.group(1) if m else None
        cache = root / "appcache/librarycache"
        wanted = {"cover": "library_600x900", "logo": "logo"}
        for kind, stem in wanted.items():
            if kind in art:
                continue
            found = list(cache.glob(f"{appid}_{stem}.*")) + list((cache / str(appid)).rglob(f"{stem}.*"))
            if found:
                art[kind] = found[0]
    return name, art


def steam_art(root, appid):
    """Cover and logo from Steam's own library cache, if it has them."""
    cache = root / "appcache/librarycache"
    art = {}
    for kind, stem in (("cover", "library_600x900"), ("logo", "logo")):
        found = sorted(cache.glob(f"{appid}_{stem}.*")) + sorted((cache / str(appid)).rglob(f"{stem}.*"))
        if found:
            art[kind] = str(found[0])
    return art


NOT_GAMES = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common|Steam Controller|Steamworks Shared)", re.I)


def steam_libraries(root):
    libs = [root]
    vdf = root / "steamapps/libraryfolders.vdf"
    if vdf.is_file():
        libs += [Path(m) for m in re.findall(r'"path"\s+"([^"]+)"', vdf.read_text(errors="ignore"))]
    return list(dict.fromkeys(libs))


def steam_games():
    """Every installed Steam game: [{appid, name, dir, cover?, logo?}]."""
    games = {}
    for root in dict.fromkeys(steam_roots()):
        for lib in steam_libraries(root):
            for manifest in (lib / "steamapps").glob("appmanifest_*.acf"):
                text = manifest.read_text(errors="ignore")
                appid = re.search(r'"appid"\s+"(\d+)"', text)
                name = re.search(r'"name"\s+"([^"]+)"', text)
                if not appid or not name or NOT_GAMES.match(name.group(1)) or appid.group(1) in games:
                    continue
                installdir = re.search(r'"installdir"\s+"([^"]+)"', text)
                entry = {"appid": appid.group(1), "name": name.group(1), **steam_art(root, appid.group(1))}
                if installdir:
                    entry["dir"] = str(lib / "steamapps/common" / installdir.group(1))
                games[appid.group(1)] = entry
    return sorted(games.values(), key=lambda g: g["name"].lower())


# ---- Steam's own settings (text VDF) ---------------------------------------
# Values are kept exactly as written (escapes untouched), so a file is
# written back unchanged apart from what Wave edits.

def vdf_loads(text):
    pos, n = 0, len(text)

    def token():
        nonlocal pos
        while pos < n:
            c = text[pos]
            if c.isspace():
                pos += 1
            elif text.startswith("//", pos):
                end = text.find("\n", pos)
                pos = n if end < 0 else end + 1
            else:
                break
        if pos >= n:
            return None
        c = text[pos]
        if c in "{}":
            pos += 1
            return c
        if c == '"':
            start = pos = pos + 1
            while pos < n and text[pos] != '"':
                pos += 2 if text[pos] == "\\" else 1
            value = text[start:pos]
            pos += 1
            return ("s", value)
        start = pos
        while pos < n and not text[pos].isspace() and text[pos] not in '{}"':
            pos += 1
        return ("s", text[start:pos])

    def block():
        out = {}
        while True:
            key = token()
            if key is None or key == "}":
                return out
            if key == "{":
                raise ValueError("unexpected {")
            value = token()
            if value is None:
                raise ValueError("file ends after a key")
            if isinstance(value, tuple) and value[1].startswith("[") and value[1].endswith("]"):
                value = token()   # skip conditional tags like [$WIN32]
            out[key[1]] = block() if value == "{" else value[1]

    return block()


def vdf_dumps(obj, depth=0):
    out, pad = [], "\t" * depth
    for key, value in obj.items():
        if isinstance(value, dict):
            out.append(f'{pad}"{key}"\n{pad}{{\n{vdf_dumps(value, depth + 1)}{pad}}}\n')
        else:
            out.append(f'{pad}"{key}"\t\t"{value}"\n')
    return "".join(out)


def vdf_child(node, key, create=False):
    """Case-insensitive lookup (Steam writes both "Steam" and "steam")."""
    for k in node:
        if k.lower() == key.lower() and isinstance(node[k], dict):
            return node[k]
    if create:
        node[key] = {}
        return node[key]
    return None


def compat_mapping(config):
    node = config
    for key in ("InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"):
        node = vdf_child(node, key)
        if node is None:
            return {}
    return node


def steam_config_file(root):
    return root / "config/config.vdf"


def read_steam_config(root):
    path = steam_config_file(root)
    try:
        return vdf_loads(path.read_text(encoding="utf-8", errors="surrogateescape"))
    except (OSError, ValueError):
        return None


def official_tool_name(folder):
    """Steam's internal name for an official Proton folder ("Proton 9.0" -> proton_9)."""
    low = folder.lower()
    if "experimental" in low:
        return "proton_experimental"
    if "hotfix" in low:
        return "proton_hotfix"
    m = re.match(r"proton (\d+)\.(\d+)", low)
    if not m:
        return None
    major, minor = m.groups()
    return f"proton_{major}" if minor == "0" else f"proton_{major}{minor}"


def compat_tools(root):
    """Proton versions this Steam install can use: [{name, label}]."""
    tools = {}
    for lib in steam_libraries(root):
        common = lib / "steamapps/common"
        for d in sorted(common.glob("Proton*")) if common.is_dir() else []:
            name = official_tool_name(d.name)
            if name and (d / "proton").exists():
                tools.setdefault(name, d.name)
    for base in (root / "compatibilitytools.d", Path("/usr/share/steam/compatibilitytools.d"),
                 Path("/usr/local/share/steam/compatibilitytools.d")):
        for manifest in sorted(base.glob("*/compatibilitytool.vdf")) if base.is_dir() else []:
            try:
                data = vdf_loads(manifest.read_text(errors="ignore"))
            except ValueError:
                continue
            for name, info in (vdf_child(data, "compatibilitytools") or {}).get("compat_tools", {}).items():
                if isinstance(info, dict):
                    tools.setdefault(name, info.get("display_name") or name)
    config = read_steam_config(root) or {}
    for entry in compat_mapping(config).values():   # names in use but not found on disk
        if isinstance(entry, dict) and entry.get("name"):
            tools.setdefault(entry["name"], entry["name"] + " (not found)")
    def order(item):
        name, label = item
        number = re.search(r"(\d+)", label)
        rank = {"proton_experimental": 0, "proton_hotfix": 1}.get(name, 2 if name.startswith("proton_") else 3)
        return (rank, -int(number.group(1)) if number else 0, label.lower())
    return [{"name": k, "label": v.replace(" - ", " ")} for k, v in sorted(tools.items(), key=order)]


def cmd_scan(_):
    """Refresh what the launcher's Add and Proton screens offer (called by the launcher)."""
    games, tools, default, mapping = steam_games(), [], "", {}
    roots = list(dict.fromkeys(steam_roots()))
    if roots:
        tools = compat_tools(roots[0])
        current = compat_mapping(read_steam_config(roots[0]) or {})
        default = (current.get("0") or {}).get("name", "") if isinstance(current.get("0"), dict) else ""
        mapping = {k: v.get("name", "") for k, v in current.items() if isinstance(v, dict) and k != "0"}
    for g in games:
        if mapping.get(g["appid"]):
            g["proton"] = mapping[g["appid"]]
    write(CACHE / "steam.json", {"games": games, "tools": tools, "defaultTool": default})


# ---- launching Steam games -------------------------------------------------

LOG = CACHE / "launch.log"


def log(*parts):
    CACHE.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a") as f:
        f.write(time.strftime("%H:%M:%S ") + " ".join(str(p) for p in parts) + "\n")


def notify(text):
    if shutil.which("notify-send"):
        subprocess.Popen(["notify-send", "-a", "Wave", "-i", "wave", "Wave", text],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def steam_running():
    pids = []
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                if (d / "comm").read_text().strip() in ("steam", "steamwebhelper"):
                    pids.append(int(d.name))
            except OSError:
                pass
    return pids


def steam_command(root):
    if ".var/app/com.valvesoftware.Steam" in str(root) and shutil.which("flatpak"):
        return ["flatpak", "run", "com.valvesoftware.Steam"]
    if shutil.which("steam"):
        return ["steam"]
    return [str(root / "steam.sh")]


def root_for(appid):
    roots = list(dict.fromkeys(steam_roots()))
    for root in roots:
        for lib in steam_libraries(root):
            if (lib / "steamapps" / f"appmanifest_{appid}.acf").is_file():
                return root
    return roots[0] if roots else None


def set_proton(root, appid, tool):
    """Make Steam's config match: tool name, or "default" for no per-game choice.
    Returns True if the file changed. Steam must not be running."""
    path = steam_config_file(root)
    config = read_steam_config(root)
    if config is None:
        raise RuntimeError(f"could not read {path}")
    node = config
    for key in ("InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"):
        node = vdf_child(node, key, create=True)
    entry = node.get(appid) if isinstance(node.get(appid), dict) else None
    if tool == "default":
        if entry is None:
            return False
        del node[appid]
    else:
        if entry and entry.get("name") == tool:
            return False
        node[appid] = {"name": tool, "config": "", "priority": "250"}
    shutil.copyfile(path, path.with_name("config.vdf.wave-backup"))
    tmp = path.with_name("config.vdf.wave-tmp")
    tmp.write_text(vdf_dumps(config), encoding="utf-8", errors="surrogateescape")
    os.replace(tmp, path)
    return True


def needs_change(root, appid, tool):
    entry = compat_mapping(read_steam_config(root) or {}).get(appid)
    current = entry.get("name", "") if isinstance(entry, dict) else ""
    return current != ("" if tool == "default" else tool)


def cmd_launch_steam(a):
    """Start a Steam game, switching its Proton version first if asked to."""
    LOG.parent.mkdir(parents=True, exist_ok=True)
    LOG.write_text("")   # the log only ever holds the latest launch
    appid = a.appid
    root = root_for(appid)
    log("launch", appid, "proton:", a.proton or "(not managed)", "root:", root)
    if root is None:
        log("no Steam install found")
        notify("Steam does not seem to be installed.")
        return
    cmd = steam_command(root)

    if a.proton and needs_change(root, appid, a.proton):
        if steam_running():
            log("Steam is running; closing it to change the Proton version")
            notify("Restarting Steam to switch the Proton version…")
            try:
                subprocess.run([*cmd, "-shutdown"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
            except (OSError, subprocess.TimeoutExpired) as err:
                log("steam -shutdown:", err)
            for _ in range(80):
                if not steam_running():
                    break
                time.sleep(0.5)
        if steam_running():
            log("Steam did not close in time; launching without changing Proton")
            notify("Steam did not close, so the Proton version was not changed.")
        else:
            try:
                changed = set_proton(root, appid, a.proton)
                log("config.vdf", "updated" if changed else "already matched")
            except (OSError, RuntimeError) as err:
                log("could not change Proton:", err)
                notify(f"Could not change the Proton version: {err}")

    running = bool(steam_running())
    args = [*cmd, *(["-silent"] if a.quiet else []), f"steam://rungameid/{appid}"]
    log("running:", " ".join(args), "(Steam was running)" if running else "(starting Steam)")
    if running:
        # Steam only passes the request on to the running client, so its output is short.
        out = open(LOG, "a")
    else:
        out = subprocess.DEVNULL
        log("Steam's own logs are in", root / "logs")
    subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True)


def cmd_steam(_):
    games = steam_games()
    if not games:
        print("No installed Steam games found.")
    for g in games:
        print(f"{g['appid']:>9}  {g['name']}")


def cmd_proton(a):
    roots = list(dict.fromkeys(steam_roots()))
    if not roots:
        die("no Steam install found")
    if not a.title:
        print("Proton versions Steam can use:")
        for t in compat_tools(roots[0]):
            print(f"  {t['name']:<28} {t['label']}")
        return
    games = read(GAMES, [])
    gid = slug(a.title)
    for g in games:
        if slug(g.get("id") or g.get("title")) == gid:
            if not re.search(r"steam://rungameid/\d+", g.get("exec", "")):
                die(f"\"{g['title']}\" is not a Steam game")
            if not a.version:
                print(g.get("proton") or "not set (Steam decides)")
                return
            if a.version == "none":
                g.pop("proton", None)
            else:
                g["proton"] = a.version
            write(GAMES, games)
            print(f"\"{g['title']}\": " + ("Steam decides" if a.version == "none" else a.version)
                  + ". It is applied the next time you start the game from Wave.")
            return
    die(f"nothing called \"{a.title}\" on the shelf (see: wave list)")


# ---- commands --------------------------------------------------------------

def cmd_add(a):
    games = read(GAMES, [])
    entry, art = {}, {}
    if a.steam:
        name, art = steam_lookup(a.steam)
        entry["title"] = a.title or name or die(
            f"could not find Steam app {a.steam} installed; pass a title: wave add \"Title\" --steam {a.steam}")
        entry["exec"] = f"steam steam://rungameid/{a.steam}"
        entry["group"] = "Steam"
    elif not a.title or not a.exec:
        die('give a title and a command:  wave add "Title" --exec "command"')
    else:
        entry["title"] = a.title
    gid = slug(entry["title"])
    if any(slug(g.get("id") or g.get("title")) == gid for g in games):
        die(f"\"{entry['title']}\" is already on the shelf (wave remove it first)")
    for key in ("exec", "group", "subtitle", "year", "color", "cwd"):
        if getattr(a, key) is not None:
            entry[key] = getattr(a, key)
    for kind in ("cover", "spine", "logo"):
        src = getattr(a, kind) or art.get(kind)
        if src:
            entry[kind] = keep_art(src, gid, kind)
    if a.prime:
        entry["prime"] = True
    games.append(entry)
    write(GAMES, games)
    extras = [k for k in ("cover", "spine", "logo") if k in entry]
    print(f"Added \"{entry['title']}\"" + (f" with {', '.join(extras)}" if extras else " (Wave will draw its artwork)"))


def cmd_remove(a):
    games = read(GAMES, [])
    gid = slug(a.title)
    kept = [g for g in games if slug(g.get("id") or g.get("title")) != gid]
    if len(kept) == len(games):
        die(f"nothing called \"{a.title}\" on the shelf (see: wave list)")
    write(GAMES, kept)
    print(f"Removed \"{a.title}\"")


def cmd_prime(a):
    games = read(GAMES, [])
    gid = slug(a.title)
    for g in games:
        if slug(g.get("id") or g.get("title")) == gid:
            if g.pop("prime", False):
                state = "off"
            else:
                g["prime"] = True
                state = "on"
            write(GAMES, games)
            print(f"Dedicated GPU {state} for \"{g['title']}\"")
            return
    die(f"nothing called \"{a.title}\" on the shelf (see: wave list)")


def cmd_list(_):
    games = read(GAMES, [])
    if not games:
        print('The shelf is empty. Add a game:  wave add "Title" --exec "command"')
    for g in games:
        print(f"{g.get('title', '?'):<32} {g.get('group', ''):<10} {'[GPU] ' if g.get('prime') else ''}{g.get('exec', '')}")


def cmd_edit(_):
    if not GAMES.exists():
        write(GAMES, [])
    os.execvp(os.environ.get("EDITOR", "nano"), [os.environ.get("EDITOR", "nano"), str(GAMES)])


def themes():
    found = {}
    for d in (REPO / "themes", CONF / "themes"):
        for f in sorted(d.glob("*.json")):
            found[f.stem] = f
    return found


def cmd_theme(a):
    cfg = read(CONFIG, {})
    if not a.name:
        for name in themes():
            print(("* " if name == cfg.get("theme", "wave") else "  ") + name)
        return
    if a.name not in themes():
        die(f"no theme called {a.name} (have: {', '.join(themes())})")
    cfg["theme"] = a.name
    write(CONFIG, cfg)
    print(f"Theme: {a.name}" + ("  (your 'wave color' palette still applies; clear it with: wave color --reset)"
                               if cfg.get("palette") else ""))


def cmd_color(a):
    cfg = read(CONFIG, {})
    if a.reset:
        cfg["palette"] = {}
        write(CONFIG, cfg)
        print("Palette cleared")
        return
    if not a.primary:
        die("give one or two colours:  wave color '#6203fc' '#000000'")
    pal = {}
    for key, val in (("primary", a.primary), ("base", a.base)):
        if val is None:
            continue
        val = val if val.startswith("#") else "#" + val
        if not re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})", val):
            die(f"{val} is not a hex colour like #6203fc")
        pal[key] = val.lower()
    cfg["palette"] = pal
    write(CONFIG, cfg)
    print("Palette: " + " + ".join(pal.values()))


def running():
    return ipc("hide")


def cmd_mem(_):
    out = subprocess.run(["pgrep", "-f", "--", f"-c {QS_CONFIG}"], capture_output=True, text=True).stdout.split()
    pids = [p for p in out if p != str(os.getpid()) and Path(f"/proc/{p}/smaps_rollup").exists()]
    if not pids:
        print("Wave is not running (it starts when you press the keybind).")
        return
    pid = pids[0]

    def cpu_ticks():
        f = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        return int(f[11]) + int(f[12])

    t0 = cpu_ticks()
    time.sleep(2)
    cpu = (cpu_ticks() - t0) / os.sysconf("SC_CLK_TCK") / 2 * 100
    kb = {}
    for line in Path(f"/proc/{pid}/smaps_rollup").read_text().splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0].rstrip(":") in ("Pss", "Rss", "Pss_Anon"):
            kb[parts[0].rstrip(":")] = int(parts[1])
    print(f"Memory  {kb.get('Pss', 0) / 1024:6.1f} MB   (its own: {kb.get('Pss_Anon', 0) / 1024:.1f} MB, with shared libraries counted in full: {kb.get('Rss', 0) / 1024:.1f} MB)")
    print(f"CPU     {cpu:6.1f} %    (averaged over 2 seconds)")


def cmd_update(_):
    if not (REPO / ".git").is_dir():
        die(f"{REPO} was not installed with git, so it cannot update itself")
    was_running = shutil.which("qs") and running()
    before = subprocess.run(["git", "-C", str(REPO), "rev-parse", "HEAD"], capture_output=True, text=True).stdout
    if subprocess.run(["git", "-C", str(REPO), "pull", "--ff-only", "--quiet"]).returncode != 0:
        die("could not update (local changes in the checkout?)")
    after = subprocess.run(["git", "-C", str(REPO), "rev-parse", "HEAD"], capture_output=True, text=True).stdout
    subprocess.run([str(REPO / "install.sh"), "--no-hyprland"], stdout=subprocess.DEVNULL)
    if was_running:
        subprocess.run(["qs", "-c", QS_CONFIG, "kill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        start()
    print("Already up to date" if before == after else "Wave updated")


def cmd_uninstall(_):
    if shutil.which("qs"):
        subprocess.run(["qs", "-c", QS_CONFIG, "kill"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    conf_home = CONF.parent
    hypr = conf_home / "hypr" / "hyprland.conf"
    if hypr.is_file():
        lines = hypr.read_text().splitlines(keepends=True)
        kept = [l for l in lines if "wave/hyprland.conf" not in l and l.strip() != "# Wave game launcher"]
        if kept != lines:
            hypr.write_text("".join(kept))
    for link in (conf_home / "quickshell" / "wave", HOME / ".local/bin/wave"):
        if link.is_symlink():
            link.unlink()
    data = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
    for f in [data / "applications" / "wave.desktop"] + list((data / "icons" / "hicolor").glob("*/apps/wave.png")):
        if f.is_file():
            f.unlink()
    print(f"Wave is uninstalled. Your games and settings are still in {CONF}.")
    print(f"To remove everything: rm -rf {REPO} {CONF}")


def main():
    ap = argparse.ArgumentParser(prog="wave", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    for name in ("toggle", "show", "hide", "start", "quit"):
        sub.add_parser(name)
    p = sub.add_parser("add", help="put a game on the shelf")
    p.add_argument("title", nargs="?")
    p.add_argument("--exec", "-e", help="command that starts the game")
    p.add_argument("--steam", metavar="APPID", help="installed Steam game; finds its name and artwork")
    p.add_argument("--group", "-g", help="tab to file it under (PC, PS2, ...)")
    p.add_argument("--subtitle")
    p.add_argument("--year", type=int)
    p.add_argument("--cover", help="cover image (copied into ~/.config/wave/covers)")
    p.add_argument("--spine", help="spine image")
    p.add_argument("--logo", help="transparent title logo")
    p.add_argument("--color", help="box colour when Wave draws the artwork")
    p.add_argument("--cwd", help="directory to run the command in")
    p.add_argument("--prime", action="store_true", help="run on the dedicated GPU")
    p.set_defaults(fn=cmd_add)
    p = sub.add_parser("remove", help="take a game off the shelf")
    p.add_argument("title")
    p.set_defaults(fn=cmd_remove)
    p = sub.add_parser("prime", help="toggle the dedicated GPU for a game")
    p.add_argument("title")
    p.set_defaults(fn=cmd_prime)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    sub.add_parser("scan").set_defaults(fn=cmd_scan)
    p = sub.add_parser("launch-steam", help="start a Steam game (used by the launcher)")
    p.add_argument("appid")
    p.add_argument("--proton", help="tool name, or 'default' for Steam's default")
    p.add_argument("--quiet", action="store_true", help="start Steam minimised if it is not running")
    p.set_defaults(fn=cmd_launch_steam)
    sub.add_parser("mem").set_defaults(fn=cmd_mem)
    sub.add_parser("update").set_defaults(fn=cmd_update)
    sub.add_parser("uninstall").set_defaults(fn=cmd_uninstall)
    sub.add_parser("steam").set_defaults(fn=cmd_steam)
    p = sub.add_parser("proton", help="list Proton versions, or set one for a Steam game")
    p.add_argument("title", nargs="?")
    p.add_argument("version", nargs="?", help="tool name, 'default' for Steam's default, 'none' to stop managing it")
    p.set_defaults(fn=cmd_proton)
    sub.add_parser("edit").set_defaults(fn=cmd_edit)
    p = sub.add_parser("theme")
    p.add_argument("name", nargs="?")
    p.set_defaults(fn=cmd_theme)
    p = sub.add_parser("color")
    p.add_argument("primary", nargs="?")
    p.add_argument("base", nargs="?")
    p.add_argument("--reset", action="store_true")
    p.set_defaults(fn=cmd_color)

    a = ap.parse_args()
    cmd = a.cmd or "toggle"
    if cmd in ("toggle", "show", "hide"):
        window(cmd)
    elif cmd == "start":
        start()
    elif cmd == "quit":
        subprocess.run(["qs", "-c", QS_CONFIG, "kill"])
    else:
        a.fn(a)


if __name__ == "__main__":
    main()
